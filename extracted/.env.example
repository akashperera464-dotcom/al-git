# ──────────────────────────────────────────────────────────────
# Verda / KDU ERP · Environment template  →  copy to `.env`
#   (Vite only exposes vars prefixed with VITE_ to the client)
#
# LIVE values for this project are committed in `.env` (Supabase project
# "KDU ERP", id lfeowzotqcrdximicoar). Keep secrets out of git in production.
# ──────────────────────────────────────────────────────────────

# ── HYBRID BACKEND ─────────────────────────────────────────────
# Firebase → Auth (Phone OTP) + Cloud Messaging (FCM) ONLY.
# (No business data in Firebase; all ERP data lives in Supabase.)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=verda-erp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=verda-erp
VITE_FIREBASE_STORAGE_BUCKET=verda-erp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_VAPID_KEY=BJ-public-vapid-key-for-fcm-web-push

# Supabase (PostgreSQL) → ALL business logic, master data & transactions.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY

# Weather (OpenWeatherMap) — deterministic alerts module
VITE_OW_API_KEY=your_openweathermap_api_key
VITE_OW_LAT=6.9679
VITE_OW_LON=80.7618

# AI module ONLY (optional). Leave blank to keep deterministic model.
VITE_GEMINI_API_KEY=

# App
VITE_APP_NAME=Verda
