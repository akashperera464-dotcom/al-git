{
  "name": "verda-tea-erp-native",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "description": "Minimal React Native WebView shell wrapping the Verda Tea Estate ERP PWA. No native plugins, no FCM, no Kotlin compilation beyond bare RN runtime.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:apk": "eas build -p android --profile preview --non-interactive",
    "build:aab": "eas build -p android --profile production --non-interactive",
    "submit": "eas submit -p android --profile production --non-interactive"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~51.0.28",
    "expo-status-bar": "~1.12.1",
    "i18next": "^23.12.2",
    "react": "18.2.0",
    "react-i18next": "^15.0.1",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-webview": "13.10.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
